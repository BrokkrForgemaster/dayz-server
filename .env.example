# ---------------------------------------------------------------------------
# Wolf's Den local Docker configuration
# ---------------------------------------------------------------------------
# Copy this file to .env before starting the container.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Steam credentials
# ---------------------------------------------------------------------------
# Anonymous login can install the dedicated server.
# Workshop downloads may require a Steam account that owns DayZ.

STEAM_USER=anonymous
STEAM_PASSWORD=

# ---------------------------------------------------------------------------
# DayZ passwords
# ---------------------------------------------------------------------------
# Leave SERVER_PASSWORD blank for a public server.
# ADMIN_PASSWORD must be changed before public deployment.

SERVER_PASSWORD=
ADMIN_PASSWORD=change-this-before-deploying

# ---------------------------------------------------------------------------
# Workshop mods
# ---------------------------------------------------------------------------
# Separate multiple Workshop IDs with semicolons.
#
# Example:
# MOD_IDS=1559212036;1710977250;1646187754
#
# Do not add mods until the unmodded server passes its first startup test.

MOD_IDS=
SERVER_MOD_IDS=

# ---------------------------------------------------------------------------
# Optional DayZ startup arguments
# ---------------------------------------------------------------------------

ADDITIONAL_STARTUP_ARGS=