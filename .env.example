# ---------------------------------------------------------------------------
# Wolf's Den local Docker configuration
# ---------------------------------------------------------------------------
# Copy this file to .env before starting the container.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Steam credentials
# ---------------------------------------------------------------------------
# Anonymous login can install the dedicated server.
# Workshop downloads may require a Steam account that owns DayZ.

STEAM_USER=anonymous
STEAM_PASSWORD=

# ---------------------------------------------------------------------------
# DayZ passwords
# ---------------------------------------------------------------------------
# Leave SERVER_PASSWORD blank for a public server.
# ADMIN_PASSWORD must be changed before public deployment.

SERVER_PASSWORD=
ADMIN_PASSWORD=change-this-before-deploying

# ---------------------------------------------------------------------------
# Workshop mods
# ---------------------------------------------------------------------------
# Separate multiple Workshop IDs with semicolons.
# Load order matters — framework/dependency mods must appear before mods that
# rely on them. Do not add mods until the vanilla server boots cleanly first.
#
# CLIENT + SERVER MODS (MOD_IDS) — players must subscribe to these too
# -------------------------------------------------------------------------
# Frameworks (must load first)
# 1559212036 = CF (Community Framework)    — dependency for most mods
# 2545327648 = Dabs Framework              — dependency for several mods
#
# DayZ Expansion modules
# 2291785308 = DayZ-Expansion-Core         — required by all Expansion mods
# 2116157322 = DayZ-Expansion-Licensed     — required for vehicles/helicopters
# 2291785437 = DayZ-Expansion-Vehicles     — land vehicles + boats
# 2792982069 = DayZ-Expansion-AI           — Expansion AI factions and patrols
# 2792984177 = DayZ-Expansion-Missions     — dynamic map missions and events
#
# Map, QoL, and base building
# 1623711988 = VanillaPlusPlusMap          — full in-game map with player markers
# 2602208478 = Basic Ear Plugs             — mute game sounds on demand (N key)
# 2303483532 = CarCover                    — camo-net covers, prevents vehicle wipe
# 1565871491 = BuilderItems                — 400+ decorative base building pieces
#
# Economy and drugs
# 1932611410 = CannabisPlus                — weed cultivation, strains, and effects
# 2170927235 = DrugsPLUS                   — cocaine crop and crafting loop
#
# Events
# 1870524790 = Airdrop-Upgraded            — scheduled and flare-called airdrops

MOD_IDS=1559212036;2545327648;2291785308;2116157322;2291785437;2792982069;2792984177;1623711988;2602208478;2303483532;1565871491;1932611410;2170927235;1870524790

# SERVER-ONLY MODS (SERVER_MOD_IDS) — not required on client
# -------------------------------------------------------------------------
# 1828439124 = VPP Admin Tools             — teleport, spawn, health, weather GUI

SERVER_MOD_IDS=1828439124

# ---------------------------------------------------------------------------
# Optional DayZ startup arguments
# ---------------------------------------------------------------------------

ADDITIONAL_STARTUP_ARGS=